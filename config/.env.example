# ========== AI 模块环境变量配置 ==========
# 复制此文件为 .env 并填写实际值

# 智谱 BigModel API Key
ZHIPU_API_KEY=your_zhipu_api_key_here

# OpenAI API Key（可选）
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI API 代理地址（可选）
# OPENAI_BASE_URL=https://api.openai.com/v1

# ========== 数据库配置 ==========
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=waimai_db